{
  "name": "scotland-counted",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:turbo": "next dev --turbopack",
    "test": "node --test 'src/**/*.test.ts'",
    "check:reps": "node scripts/check-representatives.mjs",
    "check:spacing": "node scripts/check-spacing.mjs",
    "data:build:councils": "node scripts/build-council-csv.mjs",
    "data:update:mps": "node scripts/update-mp-directory.mjs",
    "data:update:msps": "node scripts/update-holyrood-directory.mjs",
    "indexnow:plan": "node scripts/indexnow.mjs",
    "indexnow:submit": "node scripts/indexnow.mjs --submit",
    "test:indexnow": "node --test scripts/indexnow.test.mjs",
    "check:proxy": "node scripts/check-proxy.mjs",
    "check:indexability": "node scripts/check-indexability.mjs",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test e2e/a11y.spec.ts --project=chromium"
  },
  "dependencies": {
    "mermaid": "^11.16.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
